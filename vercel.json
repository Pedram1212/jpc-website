      "destination": "/product/jpc-:slug/index.html"
    },
    {
      "source": "/product/jpc-jpc-:slug",
      "destination": "/product/jpc-:slug/index.html"
    },
    {
      "source": "/series/bosch-rexroth-hf03-lg/",
      "destination": "/series/rexroth-hf03-lg/index.html"
    },
    {
      "source": "/series/bosch-rexroth-hf03-lg",
